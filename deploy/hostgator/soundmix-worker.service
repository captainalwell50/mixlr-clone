[Unit]
Description=SoundMix Live Queue Worker
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
Restart=always
RestartSec=5
WorkingDirectory=/var/www/app
ExecStart=/usr/bin/php /var/www/app/artisan queue:work database --sleep=3 --tries=3 --timeout=120 --backoff=60
TimeoutStopSec=120
KillMode=process

[Install]
WantedBy=multi-user.target
