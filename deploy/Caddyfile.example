# Azure VM / single-host: Laravel + MediaMTX behind HTTPS.
# Apex + Mixlr-style channel subdomains: https://{slug}.soundmix.live
#
# DNS (Namecheap / your registrar):
#   A     @                 → VM public IP
#   A     www               → VM public IP
#   A     *                 → VM public IP   (wildcard for channel subdomains)
#
# Laravel .env:
#   APP_URL=https://soundmix.live
#   CHANNEL_SUBDOMAINS=true
#   CHANNEL_DOMAIN=soundmix.live
#   SESSION_DOMAIN=.soundmix.live
#   SESSION_SECURE_COOKIE=true
#   MEDIAMTX_HLS_PUBLIC_BASE=https://soundmix.live/hls
#   MEDIAMTX_WEBRTC_PUBLIC_BASE=https://soundmix.live/rtc

{
	email you@example.com
	on_demand_tls {
		ask http://127.0.0.1:8080/internal/caddy-ask
	}
}

# Loopback-only Laravel for Caddy TLS ask (no public exposure).
http://127.0.0.1:8080 {
	root * /var/www/app/public
	php_fastcgi unix//run/php/php8.4-fpm.sock
	file_server
}

soundmix.live, www.soundmix.live {
	encode gzip zstd
	request_body {
		max_size 72MB
	}

	@www host www.soundmix.live
	redir @www https://soundmix.live{uri} permanent

	handle /hls/* {
		uri strip_prefix /hls
		reverse_proxy 127.0.0.1:8888
	}

	handle /rtc/* {
		uri strip_prefix /rtc
		reverse_proxy 127.0.0.1:8889
	}

	handle /build/* {
		root * /var/www/app/public
		file_server
	}

	handle /icons/* {
		root * /var/www/app/public
		file_server
	}

	handle /manifest.webmanifest {
		root * /var/www/app/public
		file_server
	}

	handle /favicon.ico {
		root * /var/www/app/public
		file_server
	}

	handle {
		root * /var/www/app/public
		try_files {path} {path}/ /index.php?{query}
		php_fastcgi unix//run/php/php8.4-fpm.sock
		file_server
	}
}

# Channel pages — Mixlr style: https://your-channel.soundmix.live/
*.soundmix.live {
	encode gzip zstd
	request_body {
		max_size 72MB
	}

	tls {
		on_demand
	}

	handle /build/* {
		root * /var/www/app/public
		file_server
	}

	handle /icons/* {
		root * /var/www/app/public
		file_server
	}

	handle /manifest.webmanifest {
		root * /var/www/app/public
		file_server
	}

	handle /favicon.ico {
		root * /var/www/app/public
		file_server
	}

	handle {
		root * /var/www/app/public
		try_files {path} {path}/ /index.php?{query}
		php_fastcgi unix//run/php/php8.4-fpm.sock
		file_server
	}
}
