# Azure VM / single-host: Laravel + MediaMTX behind HTTPS.
# Apex + Mixlr-style channel subdomains: https://{slug}.soundmix.live
#
# DNS (Cloudflare recommended):
#   A     @                 → VM public IP   DNS only (grey) — WebRTC safety
#   A     www               → VM public IP   DNS only (grey)
#   A     *                 → VM public IP   DNS only (grey)
#   A     cdn               → VM public IP   Proxied (orange) — HLS cache only
# SSL/TLS mode: Full (self-signed/origin cert OK). Full Strict needs Origin CA or public cert.
#
# Laravel .env:
#   APP_URL=https://soundmix.live
#   CHANNEL_SUBDOMAINS=true
#   CHANNEL_DOMAIN=soundmix.live
#   SESSION_DOMAIN=.soundmix.live
#   SESSION_SECURE_COOKIE=true
#   MEDIAMTX_HLS_PUBLIC_BASE=https://soundmix.live/hls
#   MEDIAMTX_WEBRTC_PUBLIC_BASE=https://soundmix.live/rtc

{
	email you@example.com
	on_demand_tls {
		ask http://127.0.0.1:8080/internal/caddy-ask
	}
}

# Loopback-only Laravel for Caddy TLS ask (no public exposure).
http://127.0.0.1:8080 {
	root * /var/www/app/public
	php_fastcgi unix//run/php/php8.4-fpm.sock
	file_server
}

soundmix.live, www.soundmix.live {
	encode gzip zstd
	request_body {
		max_size 72MB
	}

	@www host www.soundmix.live
	redir @www https://soundmix.live{uri} permanent

	handle /hls/* {
		uri strip_prefix /hls
		reverse_proxy 127.0.0.1:8888 {
			# Never surface MediaMTX Basic challenges on public playlists/segments.
			header_down -WWW-Authenticate
		}
		@playlist path *.m3u8
		header @playlist Cache-Control "public, max-age=2, must-revalidate"
		@segment path *.m4s *.ts *.mp4
		header @segment Cache-Control "public, max-age=15"
	}

	handle /rtc/* {
		uri strip_prefix /rtc
		reverse_proxy 127.0.0.1:8889
	}

	handle /build/* {
		root * /var/www/app/public
		file_server
	}

	handle /icons/* {
		root * /var/www/app/public
		file_server
	}

	handle /manifest.webmanifest {
		root * /var/www/app/public
		file_server
	}

	handle /favicon.ico {
		root * /var/www/app/public
		file_server
	}

	handle {
		root * /var/www/app/public
		try_files {path} {path}/ /index.php?{query}
		php_fastcgi unix//run/php/php8.4-fpm.sock
		file_server
	}
}

# HLS CDN origin — Cloudflare orange-clouds this host only
cdn.soundmix.live {
	encode gzip zstd

	# Self-signed OK for Cloudflare SSL Full. For Full Strict use Origin CA.
	tls /etc/caddy/certs/cdn.soundmix.live.crt /etc/caddy/certs/cdn.soundmix.live.key

	handle /hls/* {
		uri strip_prefix /hls
		reverse_proxy 127.0.0.1:8888 {
			header_down -WWW-Authenticate
		}
		@playlist path *.m3u8
		header @playlist Cache-Control "public, max-age=2, must-revalidate"
		@segment path *.m4s *.ts *.mp4
		header @segment Cache-Control "public, max-age=15"
	}

	handle {
		respond "SoundMix CDN — HLS only" 404
	}
}

# Channel pages — Mixlr style: https://your-channel.soundmix.live/
*.soundmix.live {
	encode gzip zstd
	request_body {
		max_size 72MB
	}

	tls {
		on_demand
	}

	handle /build/* {
		root * /var/www/app/public
		file_server
	}

	handle /icons/* {
		root * /var/www/app/public
		file_server
	}

	handle /manifest.webmanifest {
		root * /var/www/app/public
		file_server
	}

	handle /favicon.ico {
		root * /var/www/app/public
		file_server
	}

	handle {
		root * /var/www/app/public
		try_files {path} {path}/ /index.php?{query}
		php_fastcgi unix//run/php/php8.4-fpm.sock
		file_server
	}
}
